{
  "name": "dokassist",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:dmg": "pnpm tauri build --target aarch64-apple-darwin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte,json,css}\"",
    "lint": "eslint \"src/**/*.{js,ts,svelte}\"",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.0"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.9"
  }
}
